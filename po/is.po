#: data/io.bassi.Amberol.desktop.in.in:2
#: data/io.bassi.Amberol.metainfo.xml.in.in:6
msgid "Dismas"
msgstr "Dismas"

#: data/io.bassi.Amberol.desktop.in.in:3
msgid "Music Player"
msgstr "Tónlistarspilari"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/io.bassi.Amberol.desktop.in.in:11
msgid "music;player;media;audio;playlist;"
msgstr "tónlist;spilari;margmiðlun;hljóð;spilun;spilunarlisti"

#: data/io.bassi.Amberol.metainfo.xml.in.in:7
msgid "Plays music, and nothing else"
msgstr "Spilar tónlist og ekkert annað"

#: data/io.bassi.Amberol.metainfo.xml.in.in:9
msgid ""
"Dismas is a music player with no delusions of grandeur. If you just want to "
"play music available on your local system then Dismas is the music player "
"you are looking for."
msgstr ""
"Dismas er tónlistarspilari án alls óþarfa. Ef þú ert bara að leita að "
"spilara fyrir tónlist sem þú átt þegar á tölvunni þinni, þá er Dismas "
"eitthvað fyrir þig."

#: data/io.bassi.Amberol.metainfo.xml.in.in:14
msgid "Current features:"
msgstr "Núverandi eiginleikar:"

#: data/io.bassi.Amberol.metainfo.xml.in.in:16
msgid "adaptive UI"
msgstr "Aðlaganlegt viðmót"

#: data/io.bassi.Amberol.metainfo.xml.in.in:17
msgid "UI recoloring using the album art"
msgstr "Endurlitun notandaviðmóts út frá umslagsmyndum"

#: data/io.bassi.Amberol.metainfo.xml.in.in:18
msgid "drag and drop support to queue songs"
msgstr "stuðningur við draga og sleppa lögum í biðröð"

#: data/io.bassi.Amberol.metainfo.xml.in.in:19
msgid "shuffle and repeat"
msgstr "stokka og endurtaka"

#: data/io.bassi.Amberol.metainfo.xml.in.in:20
msgid "MPRIS integration"
msgstr "MPRIS-samþætting"

