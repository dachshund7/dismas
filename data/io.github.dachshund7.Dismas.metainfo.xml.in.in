<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPLICATION_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Dismas</name>
  <summary>Play your music library and playlists</summary>
  <description>
    <p>
      Dismas is a music player for your local music. It is a fork of Amberol,
      by Emmanuele Bassi, that adds a library and playlists.
    </p>
    <p>
      It only reads your music: it never changes your files, and it doesn't
      need the network. Everything it shows comes from the tags and the
      covers of your tracks.
    </p>
    <p>Features:</p>
    <ul>
      <li>an album grid of your music folders, with search and sorting, that follows changes to the files</li>
      <li>search by any tag, such as the conductor, the orchestra or the label, or by fields such as composer:, year: and catalogue:</li>
      <li>the albums of a composer or a performer, picked from a list</li>
      <li>a Works page that lists the works of each composer and compares their recordings</li>
      <li>playlists, with M3U import and export</li>
      <li>playlists that resume where they were</li>
      <li>smart playlists of the tracks played recently or the most, and favorite tracks, albums and works</li>
      <li>a queue you can search, sort and reorder, with Play Next</li>
      <li>gapless playback</li>
      <li>CUE sheets, which split an album ripped to a single file into its tracks</li>
      <li>work, movement and performer details for classical music</li>
      <li>lyrics from files next to the tracks or from their tags, synchronized lyrics following the music</li>
      <li>a shuffle that goes by what you've heard, and repeat</li>
      <li>ReplayGain that takes the album gain while an album plays in order</li>
      <li>a sleep timer, which can also stop after the playing track or work</li>
      <li>colors that match the cover art</li>
      <li>a tray icon while playing in the background</li>
      <li>MPRIS integration</li>
    </ul>
  </description>
  <branding>
    <color type="primary" scheme_preference="light">#e8c393</color>
    <color type="primary" scheme_preference="dark">#5e3716</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <caption>The player, with the queue</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas1.png</image>
    </screenshot>
    <screenshot>
      <caption>The album grid</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas4.png</image>
    </screenshot>
    <screenshot>
      <caption>The works, with the recordings of a concerto</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas6.png</image>
    </screenshot>
    <screenshot>
      <caption>Synchronized lyrics</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas7.png</image>
    </screenshot>
    <screenshot>
      <caption>The work and the performers of a track</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas5.png</image>
    </screenshot>
    <screenshot>
      <caption>A narrow window</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas3.png</image>
    </screenshot>
    <screenshot>
      <caption>The playlists and the smart playlists</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas2.png</image>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">@APPLICATION_ID@.desktop</launchable>
  <url type="homepage">https://github.com/dachshund7/dismas</url>
  <url type="bugtracker">https://github.com/dachshund7/dismas/issues</url>
  <url type="vcs-browser">https://github.com/dachshund7/dismas</url>
  <developer id="io.github.dachshund7">
    <name>John Hamilton</name>
  </developer>
  <translation type="gettext">dismas</translation>
  <custom>
    <value key="Purism::form_factor">mobile</value>
  </custom>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <kudos>
    <kudo>ModernToolkit</kudo>
    <kudo>Notifications</kudo>
  </kudos>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="2026.11.1" date="2026-11-05">
      <description>
        <p>Playlist previews, a Tracks toggle, artists in the Performers list, more for the desktop's media controls, and a sandbox for reading files.</p>
        <ul>
          <li>See the tracks of a playlist or a smart playlist in the pane before playing them</li>
          <li>Take only the tracks that a search matches with the Tracks toggle on the Albums page, which replaces the Tracks page</li>
          <li>Find bands and other artists in the Performers list</li>
          <li>Change the volume and Shuffle from the desktop's media controls, which get the lyrics and play counts too</li>
          <li>Files that only GStreamer can read, such as Ogg FLAC and WMA, are read in a sandbox</li>
          <li>See the line being sung in synchronized lyrics with any cover or accent color</li>
          <li>Change the repeat mode with Ctrl+R, and show the works with Ctrl+3</li>
          <li>Unmute to the volume from before, after a restart too</li>
        </ul>
      </description>
    </release>
    <release version="2026.11" date="2026-11-02">
      <description>
        <p>Works and Tracks pages, a search syntax, lyrics, gapless playback, CUE sheets, smart playlists and favorites.</p>
        <ul>
          <li>Browse the works of each composer on the Works page, and compare their recordings</li>
          <li>See only the tracks that a search matches on the Tracks page</li>
          <li>Show the albums of a composer, a conductor, an ensemble or a soloist</li>
          <li>Search by fields, such as composer:, year: or catalogue:, with OR and NOT</li>
          <li>Show the lyrics of the playing track, following the music when they're synchronized</li>
          <li>Play a track next, or add it to another playlist, from its menu</li>
          <li>Stop the music after the playing track or work</li>
          <li>Mark albums, works and recordings as favorites, and play a random album, track or work</li>
          <li>See new, changed and removed files in the album grid by themselves</li>
          <li>Open the booklets of albums</li>
          <li>Keep the quiet movements of a symphony quiet with Automatic ReplayGain, and set a pre-amp</li>
          <li>Undo removing tracks, sorting the playlist and replacing the queue</li>
          <li>Play tracks back to back, without a gap</li>
          <li>Split albums ripped to a single file into their tracks by their CUE sheets</li>
          <li>Play the tracks you played recently, the most, or not lately, and mark favorites</li>
          <li>Resume each playlist where it was</li>
          <li>Keep the tracks of a playlist whose files are missing, greyed out, until they're back</li>
          <li>Read the Work Hierarchy plugin's tags from MP3, M4A and other formats too</li>
          <li>Add music folders, such as one on a second drive, and leave out folders in them</li>
          <li>Shuffle by what you've heard, keeping the movements of a work together</li>
          <li>Play in fullscreen, or with Zen Mode, which fades out the controls</li>
          <li>Control playback from a tray icon while playing in the background</li>
          <li>Play only the tracks that a search of the queue found</li>
          <li>A new icon: the Katholische Hofkirche in Dresden</li>
        </ul>
      </description>
    </release>
    <release version="2026.10" date="2026-10-20">
      <description>
        <p>The first release of Dismas, a fork of Amberol.</p>
        <ul>
          <li>Browse the albums in your Music folder</li>
          <li>Save, import and export playlists</li>
          <li>Search and reorder the queue</li>
          <li>See works, movements and performers of classical music</li>
          <li>Stop the music with a sleep timer</li>
          <li>A new icon: Charles Bridge and Prague Castle</li>
        </ul>
      </description>
    </release>
  </releases>
  <provides>@APPLICATION_ID@.desktop</provides>
</component>
