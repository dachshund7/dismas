<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPLICATION_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Dismas</name>
  <summary>Play your music library and playlists</summary>
  <description>
    <p>
      Dismas is a music player for your local music. It is a fork of Amberol,
      by Emmanuele Bassi, that adds a library and playlists.
    </p>
    <p>
      Like Amberol, it only reads your music: it never changes your files, and
      it doesn't need the network. Everything it shows comes from the tags and
      the covers of your tracks.
    </p>
    <p>Features:</p>
    <ul>
      <li>an album grid of your music folders, with search and sorting</li>
      <li>search by any tag, such as the conductor, the orchestra or the label</li>
      <li>playlists, with M3U import and export</li>
      <li>playlists that resume where they were</li>
      <li>smart playlists of the tracks played recently or the most, and favorites</li>
      <li>a queue you can search and reorder</li>
      <li>gapless playback</li>
      <li>CUE sheets, which split an album ripped to a single file into its tracks</li>
      <li>work, movement and performer details for classical music</li>
      <li>a shuffle that goes by what you've heard, and repeat</li>
      <li>a sleep timer</li>
      <li>colors that match the cover art</li>
      <li>a tray icon while playing in the background</li>
      <li>MPRIS integration</li>
    </ul>
  </description>
  <branding>
    <color type="primary" scheme_preference="light">#e8c393</color>
    <color type="primary" scheme_preference="dark">#5e3716</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <caption>The player, with the queue</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas1.png</image>
    </screenshot>
    <screenshot>
      <caption>The album grid</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas4.png</image>
    </screenshot>
    <screenshot>
      <caption>The work and the performers of a track</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas5.png</image>
    </screenshot>
    <screenshot>
      <caption>A narrow window</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas3.png</image>
    </screenshot>
    <screenshot>
      <caption>The playlists and the smart playlists</caption>
      <image>https://raw.githubusercontent.com/dachshund7/dismas/main/data/screenshots/dismas2.png</image>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">@APPLICATION_ID@.desktop</launchable>
  <url type="homepage">https://github.com/dachshund7/dismas</url>
  <url type="bugtracker">https://github.com/dachshund7/dismas/issues</url>
  <url type="vcs-browser">https://github.com/dachshund7/dismas</url>
  <developer_name>John Hamilton</developer_name>
  <developer id="io.github.dachshund7">
    <name>John Hamilton</name>
  </developer>
  <translation type="gettext">dismas</translation>
  <custom>
    <value key="Purism::form_factor">mobile</value>
  </custom>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <kudos>
    <kudo>ModernToolkit</kudo>
    <kudo>Notifications</kudo>
  </kudos>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="2026.11" date="2026-11-01">
      <description>
        <p>Gapless playback, CUE sheets, smart playlists and favorites.</p>
        <ul>
          <li>Play tracks back to back, without a gap</li>
          <li>Split albums ripped to a single file into their tracks by their CUE sheets</li>
          <li>Play the tracks you played recently, the most, or not lately, and mark favorites</li>
          <li>Resume each playlist where it was</li>
          <li>Keep the tracks of a playlist whose files are missing, greyed out, until they're back</li>
          <li>Read the Work Hierarchy plugin's tags from MP3, M4A and other formats too</li>
          <li>Add music folders, such as one on a second drive, and leave out folders in them</li>
          <li>Shuffle by what you've heard, keeping the movements of a work together</li>
          <li>Play in fullscreen, or with Zen Mode, which fades out the controls</li>
          <li>Control playback from a tray icon while playing in the background</li>
          <li>Play only the tracks that a search of the queue found</li>
          <li>A new icon: the Katholische Hofkirche in Dresden</li>
        </ul>
      </description>
    </release>
    <release version="2026.10" date="2026-10-20">
      <description>
        <p>The first release of Dismas, a fork of Amberol.</p>
        <ul>
          <li>Browse the albums in your Music folder</li>
          <li>Save, import and export playlists</li>
          <li>Search and reorder the queue</li>
          <li>See works, movements and performers of classical music</li>
          <li>Stop the music with a sleep timer</li>
          <li>A new icon: Charles Bridge and Prague Castle</li>
        </ul>
      </description>
    </release>
  </releases>
  <provides>@APPLICATION_ID@.desktop</provides>
</component>
