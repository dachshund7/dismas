using Gtk 4.0;

template $DismasPlaybackControl: Widget {
  Box center_box {
    orientation: vertical;
    spacing: 6;
    width-request: 256;

    Box controls_box {
      spacing: 24;
      halign: center;
      hexpand: true;

      Button repeat_button {
        icon-name: "media-playlist-consecutive-symbolic";
        action-name: "queue.repeat-mode";
        valign: center;
        tooltip-text: _("Enable Repeat");

        styles [
          "circular",
        ]

        accessibility {
          label: C_("a11y", "Repeat");
        }
      }

      Button previous_button {
        icon-name: "media-skip-backward-symbolic";
        action-name: "win.previous";
        valign: center;
        tooltip-text: _("Play the Previous Track");

        styles [
          "circular",
        ]

        accessibility {
          label: C_("a11y", "Skip backwards");
        }
      }

      Button play_button {
        icon-name: "media-playback-start-symbolic";
        action-name: "win.play";
        valign: center;
        tooltip-text: _("Toggle Play");

        styles [
          "circular",
          "large",
        ]

        accessibility {
          label: C_("a11y", "Toggle play");
        }
      }

      Button next_button {
        icon-name: "media-skip-forward-symbolic";
        action-name: "win.next";
        valign: center;
        tooltip-text: _("Play the Next Track");

        styles [
          "circular",
        ]

        accessibility {
          label: C_("a11y", "Skip forward");
        }
      }

      ToggleButton shuffle_button {
        icon-name: "media-playlist-shuffle-symbolic";
        action-name: "queue.shuffle";
        valign: center;
        tooltip-text: _("Shuffle Tracks");

        accessibility {
          label: C_("a11y", "Shuffle");
        }

        styles [
          "circular",
        ]
      }
    }

    $DismasVolumeControl volume_control {
      hexpand: "true";
    }

    CenterBox {
      [end]
      Box end_box {
        halign: end;
        spacing: 12;
        margin-start: 18;

        MenuButton sleep_timer_button {
          icon-name: "weather-clear-night-symbolic";
          popover: sleep_timer_popover;
          valign: center;
          tooltip-text: _("Sleep Timer");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Sleep timer");
          }
        }

        Button locate_button {
          icon-name: "find-location-symbolic";
          action-name: "win.show-playing-track";
          valign: center;
          tooltip-text: _("Show the Playing Track");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Show the playing track");
          }
        }

        Button track_info_button {
          icon-name: "help-about-symbolic";
          action-name: "win.track-info";
          valign: center;
          tooltip-text: _("Track Information");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Track information");
          }
        }

        MenuButton more_button {
          icon-name: "view-more-symbolic";
          menu-model: more_menu;
          valign: center;
          tooltip-text: _("More Options");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "More options");
          }
        }
      }
    }
  }
}


Popover sleep_timer_popover {
  Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;

    // Shows the time left while the timer is on
    Label sleep_timer_label {
      visible: false;

      styles [
        "dim-label",
      ]
    }

    Box {
      spacing: 6;
      halign: center;

      SpinButton sleep_timer_minutes {
        numeric: true;

        adjustment: Adjustment {
          lower: 1;
          upper: 720;
          step-increment: 1;
          page-increment: 15;
          value: 30;
        };

        accessibility {
          label: C_("a11y", "Sleep timer minutes");
        }
      }

      Label {
        label: C_("sleep-timer", "minutes");
      }
    }

    CheckButton {
      label: _("_Finish Last Track");
      use-underline: true;
      action-name: "win.sleep-timer-finish-track";
    }

    Box {
      spacing: 6;
      homogeneous: true;

      Button {
        label: _("_Turn Off");
        use-underline: true;
        action-name: "win.sleep-timer-cancel";
      }

      Button {
        label: _("_Start");
        use-underline: true;
        action-name: "win.sleep-timer-start";

        styles [
          "suggested-action",
        ]
      }
    }
  }
}

menu more_menu {
  section {
    item {
      label: _("Copy");
      action: "win.copy";
    }

    item {
      label: _("Go to Album");
      action: "win.go-to-album";
    }

    item {
      label: _("Open Directory");
      action: "win.open-directory";
    }
  }
}
