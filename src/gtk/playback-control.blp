using Gtk 4.0;

template $AmberolPlaybackControl: Widget {
  Box center_box {
    orientation: vertical;
    spacing: 6;
    width-request: 256;

    Box controls_box {
      spacing: 24;
      halign: center;
      hexpand: true;

      Button previous_button {
        icon-name: "media-skip-backward-symbolic";
        action-name: "win.previous";
        valign: center;
        tooltip-text: _("Play the Previous Track");

        styles [
          "circular",
        ]

        accessibility {
          label: C_("a11y", "Skip backwards");
        }
      }

      Button play_button {
        icon-name: "media-playback-start-symbolic";
        action-name: "win.play";
        valign: center;
        tooltip-text: _("Toggle Play");

        styles [
          "circular",
          "large",
        ]

        accessibility {
          label: C_("a11y", "Toggle play");
        }
      }

      Button next_button {
        icon-name: "media-skip-forward-symbolic";
        action-name: "win.next";
        valign: center;
        tooltip-text: _("Play the Next Track");

        styles [
          "circular",
        ]

        accessibility {
          label: C_("a11y", "Skip forward");
        }
      }
    }

    $AmberolVolumeControl volume_control {
      hexpand: "true";
    }

    CenterBox {
      [start]
      Box start_box {
        halign: start;
        spacing: 12;
        margin-end: 18;

        ToggleButton playlist_button {
          icon-name: "view-queue-symbolic";
          action-name: "queue.toggle";
          valign: center;
          tooltip-text: _("Toggle Playlist");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Toggle playlist");
          }
        }

        ToggleButton shuffle_button {
          icon-name: "media-playlist-shuffle-symbolic";
          action-name: "queue.shuffle";
          valign: center;
          tooltip-text: _("Shuffle the Queue");

          accessibility {
            label: C_("a11y", "Shuffle");
          }

          styles [
            "circular",
          ]
        }
      }

      [end]
      Box end_box {
        halign: end;
        spacing: 12;
        margin-start: 18;

        Button track_info_button {
          icon-name: "help-about-symbolic";
          action-name: "win.track-info";
          valign: center;
          tooltip-text: _("Track Information");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Track information");
          }
        }

        Button repeat_button {
          icon-name: "media-playlist-consecutive-symbolic";
          action-name: "queue.repeat-mode";
          valign: center;
          tooltip-text: _("Enable Repeat");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Repeat");
          }
        }
      }
    }
  }
}
