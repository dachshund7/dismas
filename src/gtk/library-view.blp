using Gtk 4.0;
using Adw 1;

template $DismasLibraryView: Widget {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      // The title is left out when the window is too narrow for it, even
      // with the buttons of the pages folded into a menu. Under it is the
      // composer whose albums are shown, if any
      title-widget: $DismasFitBin {
        child: Adw.WindowTitle page_title {
          title: _("Albums");
        };
      };

      [start]
      $DismasPageSwitcher {}

      [end]
      MenuButton menu_button {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");

        accessibility {
          label: C_("a11y", "Primary menu");
        }
      }

      [end]
      MenuButton sort_button {
        icon-name: "view-sort-ascending-symbolic";
        tooltip-text: _("Sort Albums");
        menu-model: sort_menu;
      }

      [end]
      ToggleButton select_button {
        icon-name: "selection-mode-symbolic";
        active: bind template.selection-mode bidirectional;
        tooltip-text: _("Select Albums");
      }

      // Takes only the tracks the search, the lists and the heart match
      // from an album, rather than the whole album, see
      // `Window::set_tracks_only()`. Its tooltip says what a click does,
      // see `LibraryView::update_view()`; screen readers get one name, and
      // whether it's pressed
      [end]
      ToggleButton tracks_button {
        icon-name: "tracks-symbolic";
        action-name: "win.tracks-only";
        tooltip-text: _("Take Only the Matching Tracks");

        accessibility {
          label: _("Take Only the Matching Tracks");
        }
      }
    }

    // An open search bar, so that the entry has the same spacing as the
    // one of the queue, and the two line up side by side
    [top]
    SearchBar {
      search-mode-enabled: true;
      show-close-button: false;

      child: Adw.Clamp {
        maximum-size: 400;
        hexpand: true;

        child: Box {
          // Its accessible label follows the placeholder, see
          // `LibraryView::update_view()`
          SearchEntry search_entry {
            hexpand: true;
            placeholder-text: _("Search albums");

            accessibility {
              label: _("Search albums");
            }
          }

          // The composers of the albums, to show only the albums of one;
          // it's highlighted while it does, and hidden while no track has
          // a composer
          MenuButton composer_button {
            visible: false;
            margin-start: 6;
            icon-name: "avatar-default-symbolic";
            tooltip-text: _("Composers");

            popover: Popover composer_popover {
              child: Box {
                orientation: vertical;
                spacing: 6;

                SearchEntry composer_search {
                  placeholder-text: _("Search composers");
                }

                ScrolledWindow {
                  hscrollbar-policy: never;
                  propagate-natural-height: true;
                  min-content-width: 260;
                  max-content-height: 400;

                  child: ListView composer_list {
                    single-click-activate: true;

                    styles [
                      "navigation-sidebar",
                    ]
                  };
                }
              };
            };
          }

          // The conductors, groups and players of the albums, divided into
          // those, to show only the albums of one; like the composers
          MenuButton performer_button {
            visible: false;
            margin-start: 6;
            icon-name: "system-users-symbolic";
            tooltip-text: _("Performers");

            popover: Popover performer_popover {
              child: Box {
                orientation: vertical;
                spacing: 6;

                SearchEntry performer_search {
                  placeholder-text: _("Search performers");
                }

                ScrolledWindow {
                  hscrollbar-policy: never;
                  propagate-natural-height: true;
                  // The names of groups are long; the minimum content
                  // width doesn't apply without a horizontal scrollbar
                  width-request: 320;
                  max-content-height: 400;

                  child: ListView performer_list {
                    single-click-activate: true;

                    styles [
                      "navigation-sidebar",
                    ]
                  };
                }
              };
            };
          }

          // Shows only the favorites of the page; its tooltip, which names
          // it, says which, see `LibraryView::update_view()`
          ToggleButton favorites_button {
            margin-start: 6;
            icon-name: "heart-outline-symbolic";
            tooltip-text: _("Show Only Favorite Albums");

            styles [
              "favorites-filter",
            ]
          }
        };
      };
    }

    // What's wrong with the search, or worth knowing about it, see
    // `search::setup_query_entry()`; its title isn't markup, as the syntax
    // has "<"
    [top]
    Adw.Banner search_problem {
      use-markup: false;
      button-label: _("Search Syntax");
      action-name: "win.search-syntax";
    }

    content: Stack albums_stack {
      transition-type: crossfade;

      StackPage {
        name: "scanning";

        child: Adw.StatusPage {
          icon-name: "folder-music-symbolic";
          title: _("Scanning the Music Folders");

          child: Adw.Clamp {
            maximum-size: 300;

            child: ProgressBar scan_progress {
              show-text: true;
            };
          };
        };
      }

      StackPage {
        name: "empty";

        // It says where the albums were looked for, or that the music
        // folders aren't there, see LibraryView::update_empty_page()
        child: Adw.StatusPage empty_page {
          icon-name: "folder-music-symbolic";
          title: _("No Albums");

          child: Button empty_button {
            label: _("Choose Music Folders…");
            halign: center;
            action-name: "win.choose-music-folders";

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      StackPage {
        name: "albums";

        child: ScrolledWindow {
          hscrollbar-policy: never;
          vexpand: true;

          styles [
            "album-scroller",
          ]

          // The maximum size is set from the size of the covers
          child: Adw.ClampScrollable grid_clamp {
            unit: px;

            // The grid view keeps cells for a number of rows of
            // max-columns items, so a higher maximum makes scrolling
            // slower even when there are fewer columns
            child: GridView grid_view {
              max-columns: 6;
              // A narrow window shows a single column, rather than being
              // kept as wide as two
              min-columns: 1;
              single-click-activate: true;

              styles [
                "album-grid",
              ]
            };
          };
        };
      }

      StackPage {
        name: "works";

        child: ScrolledWindow {
          hscrollbar-policy: never;
          vexpand: true;

          styles [
            "album-scroller",
          ]

          child: Adw.ClampScrollable {
            maximum-size: 720;

            child: ListView works_list {
              single-click-activate: true;

              styles [
                "navigation-sidebar",
                "work-list",
              ]
            };
          };
        };
      }

      // The heart beside the search finds nothing on the page, see
      // `LibraryView::update_stack()`
      StackPage {
        name: "no-favorites";

        child: Adw.StatusPage no_favorites_page {
          icon-name: "heart-outline-symbolic";
        };
      }
    };

    [bottom]
    ProgressBar update_progress {
      visible: false;

      styles [
        "osd",
      ]
    }

    [bottom]
    ActionBar selection_bar {
      revealed: bind template.selection-mode;

      styles [
        "flat",
      ]

      Button select_all_button {
        icon-name: "edit-select-all-symbolic";
        tooltip-text: _("Select All Albums");
      }

      [center]
      Label selected_label {
        styles [
          "caption",
        ]
      }

      [end]
      Button play_albums_button {
        label: _("Play");

        styles [
          "suggested-action",
        ]
      }

      [end]
      Adw.SplitButton add_albums_button {
        label: _("Add to Queue");
        dropdown-tooltip: _("Play Next or Add to Another Playlist");
      }
    }
  }
}

menu sort_menu {
  section {
    item {
      label: _("Artist");
      action: "library.album-sort";
      target: "artist";
    }

    item {
      label: _("Title");
      action: "library.album-sort";
      target: "title";
    }

    item {
      label: _("Year");
      action: "library.album-sort";
      target: "year";
    }

    item {
      label: _("Date Added");
      action: "library.album-sort";
      target: "added";
    }
  }

  section {
    item {
      label: _("Ascending");
      action: "library.album-sort-order";
      target: "ascending";
    }

    item {
      label: _("Descending");
      action: "library.album-sort-order";
      target: "descending";
    }
  }
}
