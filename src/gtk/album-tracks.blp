using Gtk 4.0;
using Adw 1;

template $AmberolAlbumTracks: Widget {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button back_button {
        icon-name: "go-previous-symbolic";
        valign: center;
        tooltip-text: _("Back to the Queue");
      }

      [end]
      ToggleButton select_button {
        icon-name: "selection-mode-symbolic";
        active: bind template.selection-mode bidirectional;
        valign: center;
        tooltip-text: _("Select Tracks");
      }

      title-widget: Box {
        orientation: vertical;
        valign: center;

        Label album_title {
          ellipsize: end;

          styles [
            "heading",
          ]
        }

        Label album_artist {
          ellipsize: end;

          styles [
            "caption",
          ]
        }
      };
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;
      vexpand: true;

      child: ListView tracks_view {
        single-click-activate: true;

        styles [
          "navigation-sidebar",
            "track-list",
        ]
      };
    };

    [bottom]
    CenterBox {
      visible: bind template.selection-mode;
      margin-start: 6;
      margin-end: 6;
      margin-top: 6;

      start-widget: Button select_all_button {
        icon-name: "edit-select-all-symbolic";
        tooltip-text: _("Select All Tracks");

        styles [
          "flat",
        ]
      };

      center-widget: Label selected_label {
        styles [
          "caption",
        ]
      };
    }

    [bottom]
    Box {
      halign: center;
      spacing: 12;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      Button play_button {
        label: _("Play");

        styles [
          "pill",
          "suggested-action",
        ]
      }

      Button add_button {
        label: _("Add to Queue");

        styles [
          "pill",
        ]
      }
    }

    styles [
      "playlist-background",
    ]
  }
}
