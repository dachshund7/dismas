using Gtk 4.0;
using Adw 1;

template $DismasAlbumTracks: Widget {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button back_button {
        icon-name: "go-previous-symbolic";
        valign: center;
      }

      [end]
      ToggleButton select_button {
        icon-name: "selection-mode-symbolic";
        active: bind template.selection-mode bidirectional;
        valign: center;
        tooltip-text: _("Select Tracks");
      }

      title-widget: Box {
        orientation: vertical;
        valign: center;

        Label album_title {
          ellipsize: end;

          styles [
            "heading",
          ]
        }

        Label album_artist {
          ellipsize: end;

          styles [
            "caption",
          ]
        }
      };
    }

    // When the album was made, its record label and its catalogue number;
    // hidden for the recordings of a work, which each have their year
    [top]
    Label album_info {
      visible: false;
      ellipsize: end;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 6;

      styles [
        "caption",
        "dim-label",
      ]
    }

    // While the search leaves out some of the album's tracks, how many it
    // matches; the others are dimmed, and the menu next to the Add button
    // takes them all
    [top]
    Revealer filter_bar {
      child: Box {
        spacing: 6;

        styles [
          "album-filter-bar",
        ]

        Label filter_label {
          hexpand: true;
          wrap: true;
          xalign: 0;
          margin-start: 6;
        }
      };
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;
      vexpand: true;

      child: ListView tracks_view {
        single-click-activate: true;

        styles [
          "navigation-sidebar",
            "track-list",
        ]
      };
    };

    [bottom]
    CenterBox {
      visible: bind template.selection-mode;
      margin-start: 6;
      margin-end: 6;
      margin-top: 6;

      start-widget: Button select_all_button {
        icon-name: "edit-select-all-symbolic";
        tooltip-text: _("Select All Tracks");

        styles [
          "flat",
        ]
      };

      center-widget: Label selected_label {
        styles [
          "caption",
        ]
      };
    }

    // For a work, only in selection mode, as each recording has its own
    // Play button
    [bottom]
    Box buttons {
      halign: center;
      spacing: 12;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      Button play_button {
        label: _("Play");

        styles [
          "pill",
          "suggested-action",
        ]
      }

      Adw.SplitButton add_button {
        label: _("Add to Queue");
        dropdown-tooltip: _("Play Next or Add to Another Playlist");

        styles [
          "pill",
        ]
      }
    }

    styles [
      "playlist-background",
    ]
  }
}
