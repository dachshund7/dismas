using Gtk 4.0;

template $DismasQueueRow: Widget {
  Box {
    // The whole height of the row can be grabbed, not just the icon
    Image drag_handle {
      icon-name: "drag-handle-symbolic";
      valign: fill;
      visible: false;

      styles [
        "drag-handle",
      ]

      accessibility {
        label: C_("a11y", "Drag to move");
      }
    }

    Stack track_cover_stack {
      StackPage {
        name: "no-cover";

        child: Image {
          icon-name: "folder-music-symbolic";
          pixel-size: 32;

          styles [
            "dim-label",
            "cover-placeholder",
            "small",
          ]

          accessibility {
            label: C_("a11y", "No cover available");
          }
        };
      }

      StackPage {
        name: "cover";

        child: $DismasCoverPicture track_cover_image {
          cover-size: "1";
          halign: "center";
          valign: "center";
        };
      }
    }

    Box {
      orientation: vertical;
      valign: center;
      hexpand: true;
      spacing: 3;

      Inscription track_title_label {
        xalign: 0;
        text-overflow: ellipsize_end;

        styles [
          "track-title",
        ]
      }

      Inscription track_artist_label {
        xalign: 0;
        text-overflow: ellipsize_end;

        styles [
          "track-artist",
        ]
      }

      // The performers, for movements whose second line is the parts of
      // the work above them
      Inscription track_credits_label {
        xalign: 0;
        text-overflow: ellipsize_end;
        visible: false;

        styles [
          "track-artist",
        ]
      }

    }

    [end]
    Image track_playing_image {
      icon-name: "media-playback-start-symbolic";
      pixel-size: 16;
      halign: center;
      valign: center;
      opacity: 0;

      accessibility {
        label: C_("a11y", "Currently playing");
      }
    }

    styles [
      "track-details",
    ]
  }
}
