using Gtk 4.0;

template $DismasQueueRow: Widget {
  Box {
    // The whole height of the row can be grabbed, not just the icon
    Image drag_handle {
      icon-name: "drag-handle-symbolic";
      valign: fill;
      visible: false;

      styles [
        "drag-handle",
      ]

      accessibility {
        label: C_("a11y", "Drag to move");
      }
    }

    // Centered, so the icon of the playing track covers the cover alone,
    // not the height of a row whose text takes more lines
    Overlay {
      valign: center;

      child: Stack track_cover_stack {
        StackPage {
          name: "no-cover";

          child: Image {
            icon-name: "folder-music-symbolic";
            pixel-size: 32;

            styles [
              "dim-label",
              "cover-placeholder",
              "small",
            ]

            accessibility {
              label: C_("a11y", "No cover available");
            }
          };
        }

        StackPage {
          name: "cover";

          child: $DismasCoverPicture track_cover_image {
            cover-size: "1";
            halign: "center";
            valign: "center";
          };
        }
      };

      // Over the cover of the track playing, rather than at the end of the
      // row, where every other row kept its room empty; it takes no input,
      // so a click or a long press on the cover still reaches the row
      [overlay]
      Image track_playing_image {
        icon-name: "media-playback-start-symbolic";
        pixel-size: 16;
        opacity: 0;
        can-target: false;

        styles [
          "playing-indicator",
        ]

        accessibility {
          label: C_("a11y", "Currently playing");
        }
      }
    }

    Box {
      orientation: vertical;
      valign: center;
      hexpand: true;
      spacing: 3;

      Inscription track_title_label {
        xalign: 0;
        text-overflow: ellipsize_end;

        styles [
          "track-title",
        ]
      }

      Inscription track_artist_label {
        xalign: 0;
        text-overflow: ellipsize_end;

        styles [
          "track-artist",
        ]
      }

      // The performers, for movements whose second line is the parts of
      // the work above them
      Inscription track_credits_label {
        xalign: 0;
        text-overflow: ellipsize_end;
        visible: false;

        styles [
          "track-artist",
        ]
      }

    }

    styles [
      "track-details",
    ]
  }
}
