using Gtk 4.0;
using Adw 1;

template $AmberolTrackInfoDialog: Adw.Dialog {
  title: _("Track Information");
  content-width: 480;
  content-height: 640;

  styles [
    "track-info",
  ]

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup work_group {
        title: _("Work");
      }

      Adw.PreferencesGroup performance_group {
        title: _("Performance");
      }

      Adw.PreferencesGroup production_group {
        title: _("Production");
      }

      Adw.PreferencesGroup release_group {
        title: _("Release");
      }

      Adw.PreferencesGroup musicbrainz_group {
        title: "MusicBrainz";
      }

      Adw.PreferencesGroup file_group {
        title: _("File");
      }
    };
  };
}
