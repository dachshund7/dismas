using Gtk 4.0;
using Adw 1;

template $AmberolWindow: Adw.ApplicationWindow {
  handle-menubar-accel: true;
  default-width: 800;

  content: $DragOverlay drag_overlay {
    title: _("Drop a track to add it to the queue");

    child: Adw.ToastOverlay toast_overlay {
      child: Adw.OverlaySplitView split_view {
        max-sidebar-width: 330;
        sidebar-width-fraction: 0.4;
        // The sidebar is hidden and shown again when collapsing in
        // window/bindings.rs, to keep it hidden if the user hid it
        pin-sidebar: true;

        // Drawn next to the sidebar when collapsed, as if pushed aside
        content: $AmberolPushBin {
          child: Stack content_stack {
            transition-type: crossfade;

            StackPage {
              name: "player";

              child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                  show-title: false;

                  [start]
                  $AmberolPageSwitcher {}

                  [end]
                  MenuButton menu_button {
                    icon-name: "open-menu-symbolic";
                    tooltip-text: _("Main Menu");

                    accessibility {
                      label: C_("a11y", "Primary menu");
                    }
                  }
                }

                content: $AmberolPlayerBox main_box {
                  vexpand: true;

                  styles [
                    "main-box",
                  ]

                  $AmberolTrackCover track_cover {}

                  Box {
                    orientation: vertical;
                    spacing: 2;
                    width-request: 256;

                    styles [
                      "cover-width",
                    ]

                    $AmberolWaveformView waveform_view {
                      can-focus: "true";
                    }

                    CenterBox {
                      orientation: horizontal;
                      width-request: 256;

                      [start]
                      Label elapsed_label {
                        label: "0:00";

                        accessibility {
                          label: C_("a11y", "Elapsed time");
                        }

                        styles [
                          "caption",
                          "numeric",
                        ]
                      }

                      [end]
                      Label remaining_label {
                        label: "0:00";

                        accessibility {
                          label: C_("a11y", "Remaining time");
                        }

                        styles [
                          "caption",
                          "numeric",
                        ]
                      }
                    }
                  }

                  $AmberolTrackDetails track_details {}

                  $AmberolPlaybackControl playback_control {
                    halign: "center";
                    margin-top: "0";
                    margin-bottom: "24";
                  }
                };
              };
            }

            StackPage {
              name: "library";

              child: $AmberolLibraryView library_view {};
            }

            StackPage {
              name: "playlists";

              child: $AmberolPlaylistsPage playlists_page {};
            }
          };
        };

        sidebar: Box {
          styles [
            "playlist-pane",
          ]

          Stack sidebar_stack {
            hexpand: true;
            transition-type: crossfade;

            StackPage {
              name: "playlist";

              child: $AmberolPlaylistView playlist_view {};
            }

            StackPage {
              name: "album";

              child: $AmberolAlbumTracks album_tracks {};
            }
          }

          Box sidebar_handle {
            width-request: 6;
            tooltip-text: _("Drag to Resize the Playlist, Double-Click to Reset");

            styles [
              "sidebar-handle",
            ]
          }
        };
      };
    };
  };

  // The condition is replaced with the width the sidebar and the content
  // need side by side, once they're measured
  Adw.Breakpoint narrow_breakpoint {
    condition ("max-width: 560sp")

    setters {
      split_view.collapsed: true;
    }
  }
}
