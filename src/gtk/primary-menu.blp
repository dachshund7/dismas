using Gtk 4.0;

// The main menu, shared by the buttons of the player, the album grid and
// the playlists; see utils::primary_menu()
menu primary_menu {
  // For tracks outside the music folders, as a phone has nothing to drag
  // them from
  section {
    item {
      label: _("Add _Tracks…");
      action: "win.add-tracks";
    }

    item {
      label: _("Add F_older…");
      action: "win.add-folder";
    }
  }

  section {
    item {
      label: _("_Fullscreen");
      action: "win.enter-fullscreen";
      // F11 is `win.fullscreen`'s
      accel: "F11";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Search Syntax");
      action: "win.search-syntax";
    }

    item {
      label: _("_About Dismas");
      action: "app.about";
    }

    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
