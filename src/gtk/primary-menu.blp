using Gtk 4.0;

// The main menu, shared by the buttons of the player, the album grid and
// the playlists; see utils::primary_menu()
menu primary_menu {
  section {
    item {
      label: _("Copy");
      action: "win.copy";
    }

    item {
      label: _("Open Directory");
      action: "win.open-directory";
    }

    item {
      label: _("Track _Information");
      action: "win.track-info";
    }
  }

  section {
    item {
      label: _("Clear");
      action: "queue.clear";
    }
  }

  section {
    item {
      label: _("_Match Cover Art");
      action: "win.enable-recoloring";
    }

    item {
      label: _("_Background Playback");
      action: "app.background-play";
    }

    item {
      label: _("_Restore Playlist at Startup");
      action: "win.restore-playlist";
    }
  }

  section {
    submenu {
      label: _("_ReplayGain");

      item {
        label: C_("replaygain-menu", "_Album");
        action: "win.replaygain";
        target: "album";
      }

      item {
        label: C_("replaygain-menu", "_Track");
        action: "win.replaygain";
        target: "track";
      }

      item {
        label: C_("replaygain-menu", "_Disabled");
        action: "win.replaygain";
        target: "off";
      }
    }
  }

  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Amberol");
      action: "app.about";
    }

    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
