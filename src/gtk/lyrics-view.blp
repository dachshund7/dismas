using Gtk 4.0;
using Adw 1;

template $DismasLyricsView: Widget {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button back_button {
        icon-name: "go-previous-symbolic";
        valign: center;
        tooltip-text: _("Hide Lyrics");
      }

      title-widget: Adw.WindowTitle window_title {
        title: _("Lyrics");
      };
    }

    content: Stack stack {
      transition-type: crossfade;

      // While the lyrics of a new track are read
      StackPage {
        name: "reading";

        child: Box {};
      }

      StackPage {
        name: "plain";

        child: ScrolledWindow {
          hscrollbar-policy: never;
          vexpand: true;

          // A text view rather than a label, so that the text can be
          // selected and copied, and read with a caret by screen readers
          child: TextView text_view {
            editable: false;
            cursor-visible: true;
            wrap-mode: word_char;
            top-margin: 12;
            bottom-margin: 24;
            left-margin: 18;
            right-margin: 18;
            pixels-below-lines: 2;

            buffer: TextBuffer {
              enable-undo: false;
            };

            accessibility {
              label: C_("a11y", "Lyrics");
            }

            styles [
              "lyrics",
            ]
          };
        };
      }

      // Synchronized lyrics, with the line sung highlighted in the middle;
      // a line is a row, so that the keys go from line to line, and a
      // line that's activated is sung from its start
      StackPage {
        name: "synced";

        child: ScrolledWindow synced_scrolled {
          hscrollbar-policy: never;
          vexpand: true;

          child: ListBox lines_box {
            selection-mode: none;
            activate-on-single-click: true;

            accessibility {
              label: C_("a11y", "Lyrics");
            }

            styles [
              "synced-lyrics",
            ]
          };
        };
      }

      StackPage {
        name: "none";

        child: Adw.StatusPage {
          icon-name: "lyrics-symbolic";
          title: _("No Lyrics");

          styles [
            "compact",
          ]
        };
      }
    };
  }
}
