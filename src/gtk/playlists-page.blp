using Gtk 4.0;
using Adw 1;

template $DismasPlaylistsPage: Widget {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      // The title is left out when the window is too narrow for it, even
      // with the buttons of the pages folded into a menu
      title-widget: $DismasFitBin {
        child: Adw.WindowTitle {
          title: _("Playlists");
        };
      };

      [start]
      $DismasPageSwitcher {}

      [end]
      MenuButton menu_button {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");

        accessibility {
          label: C_("a11y", "Primary menu");
        }
      }

      [end]
      Button new_button {
        icon-name: "list-add-symbolic";
        action-name: "win.new-playlist";
        tooltip-text: _("New Playlist");
      }

      [end]
      Button import_button {
        icon-name: "document-open-symbolic";
        action-name: "win.import-playlist";
        tooltip-text: _("Import a Playlist");
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;

      child: Adw.Clamp {
        maximum-size: 500;
        margin-top: 12;
        margin-bottom: 24;
        margin-start: 12;
        margin-end: 12;

        child: Box {
          orientation: vertical;
          valign: start;
          spacing: 24;

          ListBox playlists_list {
            selection-mode: none;

            accessibility {
              label: C_("a11y", "Playlists");
            }

            styles [
              "boxed-list",
            ]
          }

          // They play a snapshot in place of the queue, so they're never
          // the selected playlist
          Adw.PreferencesGroup {
            title: _("Smart Playlists");

            Adw.ActionRow {
              title: _("Recently Played");
              subtitle: _("The last 100 tracks played");
              activatable: true;
              action-name: "win.play-smart-playlist";
              action-target: "'recently-played'";

              [suffix]
              Image {
                icon-name: "media-playback-start-symbolic";
              }
            }

            Adw.ActionRow {
              title: _("Most Played");
              subtitle: _("The tracks played the most in the last 6 months");
              activatable: true;
              action-name: "win.play-smart-playlist";
              action-target: "'most-played'";

              [suffix]
              Image {
                icon-name: "media-playback-start-symbolic";
              }
            }
          }
        };
      };
    };
  }
}
