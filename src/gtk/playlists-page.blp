using Gtk 4.0;
using Adw 1;

template $AmberolPlaylistsPage: Widget {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: _("Playlists");
      };

      [start]
      $AmberolPageSwitcher {}

      [end]
      MenuButton menu_button {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");

        accessibility {
          label: C_("a11y", "Primary menu");
        }
      }

      [end]
      Button new_button {
        icon-name: "list-add-symbolic";
        action-name: "win.new-playlist";
        tooltip-text: _("New Playlist");
      }

      [end]
      Button import_button {
        icon-name: "document-open-symbolic";
        action-name: "win.import-playlist";
        tooltip-text: _("Import a Playlist");
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;

      child: Adw.Clamp {
        maximum-size: 500;
        margin-top: 12;
        margin-bottom: 24;
        margin-start: 12;
        margin-end: 12;

        child: ListBox playlists_list {
          valign: start;
          selection-mode: none;

          accessibility {
            label: C_("a11y", "Playlists");
          }

          styles [
            "boxed-list",
          ]
        };
      };
    };
  }
}
