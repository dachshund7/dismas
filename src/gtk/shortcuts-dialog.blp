using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {

    Adw.ShortcutsSection {
        title: C_("shortcut window", "General");

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Toggle primary menu");
            accelerator: "F10";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Copy track details to the clipboard");
            accelerator: "<primary>c";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show track information");
            action-name: "win.track-info";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show or hide the lyrics");
            action-name: "win.lyrics";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show the player");
            accelerator: "<primary>1";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show the album grid");
            accelerator: "<primary>2 <primary>g";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show the works");
            accelerator: "<primary>3";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show the playlists");
            accelerator: "<primary>4";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Toggle fullscreen");
            action-name: "win.fullscreen";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show preferences");
            action-name: "win.preferences";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Show shortcuts");
            action-name: "app.shortcuts";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Quit");
            action-name: "app.quit";
        }
    }

    Adw.ShortcutsSection {
        title: C_("shortcut window", "Playlist");

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Add tracks");
            action-name: "win.add-tracks";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Add a folder");
            action-name: "win.add-folder";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Remove all tracks");
            action-name: "queue.clear";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Toggle the playlist pane");
            action-name: "queue.toggle";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Search tracks");
            action-name: "queue.find";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Toggle shuffling tracks");
            action-name: "queue.shuffle";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Open the menu of a track or an album");
            accelerator: "Menu <shift>F10";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Move the track up");
            accelerator: "<alt>Up";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Move the track down");
            accelerator: "<alt>Down";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Select all tracks or albums");
            accelerator: "<primary>a";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Remove the selected tracks");
            accelerator: "Delete";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Undo replacing the queue");
            accelerator: "<primary>z";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Leave selection mode or hide the playlist pane");
            accelerator: "Escape";
        }
    }

    Adw.ShortcutsSection {
        title: C_("shortcut window", "Playback");

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Toggle play/pause");
            accelerator: "space";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Previous track");
            action-name: "win.previous";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Next track");
            action-name: "win.next";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Seek backwards in the current track");
            accelerator: "<primary>Left";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Seek forward in the current track");
            accelerator: "<primary>Right";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Raise the volume");
            action-name: "win.volume-up";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Lower the volume");
            action-name: "win.volume-down";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Mute or unmute");
            action-name: "win.toggle-mute";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Change the repeat mode");
            action-name: "queue.repeat-mode";
        }

        Adw.ShortcutsItem {
            title: C_("shortcut window", "Add the current track to favorites, or remove it");
            action-name: "win.favorite";
        }
    }
}
