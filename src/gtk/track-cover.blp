using Gtk 4.0;

template $DismasTrackCover: Widget {
  Stack cover_stack {
    StackPage {
      name: "no-image";

      child: Image {
        overflow: hidden;
        icon-name: "folder-music-symbolic";
        pixel-size: 64;

        styles [
          "cover-placeholder",
          "dim-label",
        ]
      };
    }

    StackPage {
      name: "cover-image";

      child: $DismasCoverPicture album_image {};
    }
  }
}
