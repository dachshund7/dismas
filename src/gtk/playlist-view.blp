using Gtk 4.0;
using Adw 1;

template $DismasPlaylistView: Widget {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      ToggleButton search_button {
        icon-name: "system-search-symbolic";
        action-name: "queue.search";
        valign: center;
        tooltip-text: _("Search Tracks");
      }

      title-widget: Box queue_length_box {
        orientation: vertical;
        valign: center;

        Label title_label {
          ellipsize: end;
          label: _("Queue");

          styles [
            "heading",
          ]
        }

        Label queue_length_label {
          ellipsize: end;

          styles [
            "caption",
          ]
        }
      };

      [end]
      Button back_button {
        visible: false;
        icon-name: "go-previous-symbolic";
        action-name: "queue.toggle";
        valign: center;
      }

      [end]
      ToggleButton select_button {
        icon-name: "selection-mode-symbolic";
        action-name: "queue.select";
        valign: center;
        tooltip-text: _("Select Tracks");
      }

      [end]
      Button clear_button {
        icon-name: "edit-clear-all-symbolic";
        action-name: "queue.clear";
        valign: center;
        tooltip-text: _("Remove All Tracks");
      }
    }

    [top]
    // Clamped like the search entry of the albums, as the playlist can
    // be resized, and covers the window when it's narrow
    SearchBar queue_searchbar {
      child: Adw.Clamp {
        maximum-size: 400;
        hexpand: true;

        child: SearchEntry queue_searchentry {
          placeholder-text: _("Search tracks");

          accessibility {
            label: C_("a11y", "Search");
            description: C_("a11y", "Type to search tracks");
          }
        };
      };
    }

    content: Overlay queue_overlay {
      [overlay]
      ProgressBar queue_progress {
        valign: start;
        hexpand: true;
        visible: false;

        styles [
          "osd",
        ]
      }

      ScrolledWindow queue_scrolled {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        propagate-natural-height: true;
        vexpand: true;

        styles [
          "track-scroller",
        ]

        child: ListView queue_view {
          single-click-activate: true;

          styles [
            "navigation-sidebar",
            "track-list",
          ]
        };
      }
    };

    [bottom]
    ActionBar queue_actionbar {
      revealed: false;

      styles [
        "flat",
      ]

      Button queue_select_all_button {
        icon-name: "edit-select-all-symbolic";
        tooltip-text: _("Select All Tracks");
      }

      [center]
      Label queue_selected_label {
        styles [
          "caption",
        ]
      }

      [end]
      Button queue_remove_button {
        action-name: "queue.remove-selected";
        icon-name: "app-remove-symbolic";
        tooltip-text: _("Remove Selected Tracks");
      }
    }

    styles [
      "playlist-background",
    ]
  }
}
