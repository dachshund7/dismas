using Gtk 4.0;
using Adw 1;

template $DismasPlaylistView: Widget {
  Adw.ToolbarView {
    [top]
    // The time left often makes the title wider than the room between the
    // one button at the start and the two at the end, which pushed it off
    // center; it's shortened instead. The back button of the collapsed
    // split view makes the end side wider still, so the title is only
    // kept in the middle while it's hidden (playlist_view.rs)
    Adw.HeaderBar header_bar {
      centering-policy: strict;

      [start]
      ToggleButton search_button {
        icon-name: "system-search-symbolic";
        action-name: "queue.search";
        valign: center;
        tooltip-text: _("Search Tracks");
      }

      // The title switches to another playlist, as going back to the
      // queue would otherwise take a trip through the Playlists page. The
      // time left stays out of it, keeping the whole width of the title
      title-widget: Box queue_length_box {
        orientation: vertical;
        valign: center;

        MenuButton title_menu_button {
          always-show-arrow: true;
          can-shrink: true;
          halign: center;
          tooltip-text: _("Switch Playlist");

          child: Label title_label {
            ellipsize: end;
            label: _("Queue");

            styles [
              "heading",
            ]
          };

          styles [
            "flat",
            "playlist-title",
          ]
        }

        Label queue_length_label {
          ellipsize: end;

          styles [
            "caption",
          ]
        }
      };

      [end]
      Button back_button {
        visible: false;
        icon-name: "go-previous-symbolic";
        action-name: "queue.toggle";
        valign: center;
      }

      [end]
      ToggleButton select_button {
        icon-name: "selection-mode-symbolic";
        action-name: "queue.select";
        valign: center;
        tooltip-text: _("Select Tracks");
      }

      [end]
      Button clear_button {
        icon-name: "edit-clear-all-symbolic";
        action-name: "queue.clear";
        valign: center;
        tooltip-text: _("Remove All Tracks");
      }
    }

    [top]
    // Clamped like the search entry of the albums, as the playlist can
    // be resized, and covers the window when it's narrow
    SearchBar queue_searchbar {
      child: Adw.Clamp {
        maximum-size: 400;
        hexpand: true;

        child: SearchEntry queue_searchentry {
          placeholder-text: _("Search tracks");

          accessibility {
            label: C_("a11y", "Search");
            description: C_("a11y", "Type to search tracks");
          }
        };
      };
    }

    content: Overlay queue_overlay {
      [overlay]
      ProgressBar queue_progress {
        valign: start;
        hexpand: true;
        visible: false;

        styles [
          "osd",
        ]
      }

      ScrolledWindow queue_scrolled {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        propagate-natural-height: true;
        vexpand: true;

        styles [
          "track-scroller",
        ]

        child: ListView queue_view {
          single-click-activate: true;

          styles [
            "navigation-sidebar",
            "track-list",
          ]
        };
      }
    };

    [bottom]
    ActionBar queue_actionbar {
      revealed: false;

      styles [
        "flat",
      ]

      Button queue_select_all_button {
        icon-name: "edit-select-all-symbolic";
        tooltip-text: _("Select All Tracks");
      }

      [center]
      Label queue_selected_label {
        styles [
          "caption",
        ]
      }

      [end]
      Button queue_remove_button {
        action-name: "queue.remove-selected";
        icon-name: "app-remove-symbolic";
        tooltip-text: _("Remove Selected Tracks");
      }
    }

    styles [
      "playlist-background",
    ]
  }
}
