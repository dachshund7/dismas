using Gtk 4.0;

template $DismasTrackDetails: Widget {
  Box {
    orientation: vertical;
    spacing: 12;

    Box {
      orientation: vertical;
      valign: center;
      margin-start: 6;
      margin-end: 6;

      $DismasMarquee track_title_label {
        width-chars: "20";

        styles [
          "track-title",
        ]
      }

      $DismasMarquee track_movement_label {
        width-chars: "25";
        visible: false;

        styles [
          "track-movement",
        ]
      }

      $DismasMarquee track_artist_label {
        width-chars: "25";

        styles [
          "track-artist",
        ]
      }

      $DismasMarquee track_album_label {
        width-chars: "25";

        styles [
          "track-album",
        ]
      }

      $DismasMarquee track_credits_label {
        width-chars: "25";
        visible: false;

        styles [
          "track-credits",
        ]
      }
    }
  }
}
