{
    "app-id" : "io.github.dachshund7.Dismas.Devel",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "dismas",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=xdg-music:ro"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "build-args" : [
            "--share=network"
        ],
        "env" : {
            "CARGO_INCREMENTAL" : "0",
            "CARGO_PROFILE_DEV_DEBUG" : "line-tables-only",
            "G_MESSAGES_DEBUG" : "none",
            "RUST_BACKTRACE" : "1",
            "RUST_LOG" : "dismas=debug,glib=debug"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "dismas",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts": [
                "-Dprofile=development"
            ],
            "sources" : [
                {
                    "type" : "dir",
                    "path" : ".",
                    "skip" : [
                        "_build",
                        "target",
                        ".flatpak-builder",
                        "flatpak-build",
                        "flatpak-repo",
                        "flatpak_app",
                        "repo"
                    ]
                }
            ]
        }
    ]
}
